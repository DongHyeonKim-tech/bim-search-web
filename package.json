    "axios": "^1.13.6",
    "camelcase-keys": "^10.0.2",
    "env-cmd": "^11.0.0",
    "next": "16.4.6",
    "openai": "^5.20.2",
    "prettier": "^3.8.1",
    "react": "19.3.1",
    "react-cookie": "^8.1.0",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.4.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
